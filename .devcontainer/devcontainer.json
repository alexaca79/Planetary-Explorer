{
  "name": "Planetary Explorer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20",
      "nodeGypDependencies": true,
      "npmVersion": "none",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true,
      "bicepVersion": "latest"
    },
    "ghcr.io/azure/azure-dev/azd:0": {
      "version": "stable"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "containerEnv": {
    "BACKEND_PORT": "8000",
    "FRONTEND_PORT": "5173"
  },
  "forwardPorts": [
    5173,
    8000,
    8080,
    8090
  ],
  "portsAttributes": {
    "5173": {
      "label": "Planetary Explorer web UI",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Planetary Explorer API",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Container App or MCP API",
      "onAutoForward": "notify"
    },
    "8090": {
      "label": "Weather stub",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=planetary-explorer-azure-cli,target=/home/vscode/.azure,type=volume",
    "source=planetary-explorer-azd,target=/home/vscode/.azd,type=volume",
    "source=planetary-explorer-github-cli,target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "EchoAPI.echoapi-for-vscode",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-containers",
        "ms-python.black-formatter",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.azurecli",
        "ms-vscode.powershell"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/planetary-explorer/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "planetary-explorer/container-app/tests"
        ],
        "python.analysis.extraPaths": [
          "planetary-explorer/container-app"
        ],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
