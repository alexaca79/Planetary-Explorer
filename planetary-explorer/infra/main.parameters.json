{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "cloudEnvironment": {
      "value": "Commercial"
    },
    "containerImage": {
      "value": "${SERVICE_API_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}"
    },
    "apiContainerAppName": {
      "value": "${API_CONTAINER_APP_NAME=}"
    },
    "existingContainerAppsEnvironmentName": {
      "value": "${EXISTING_CONTAINER_APPS_ENVIRONMENT_NAME=}"
    },
    "deployApiContainer": {
      "value": "${DEPLOY_API_CONTAINER=true}"
    },
    "existingApiUrl": {
      "value": "${API_CONTAINER_APP_URL=}"
    },
    "frontendWebAppName": {
      "value": "${AZURE_WEB_APP_NAME=}"
    },
    "frontendAppServicePlanName": {
      "value": "${AZURE_APP_SERVICE_PLAN_NAME=}"
    },
    "frontendUrl": {
      "value": "${FRONTEND_URL=}"
    },
    "deployFrontend": {
      "value": "${DEPLOY_FRONTEND=true}"
    },
    "deployAIFoundry": {
      "value": "${DEPLOY_AI_FOUNDRY=true}"
    },
    "azureOpenAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT=}"
    },
    "existingAiProjectEndpoint": {
      "value": "${EXISTING_AI_PROJECT_ENDPOINT=}"
    },
    "deployChatHistory": {
      "value": "${DEPLOY_CHAT_HISTORY=true}"
    },
    "deployChatMemory": {
      "value": "${DEPLOY_CHAT_MEMORY=true}"
    },
    "chatMemoryIndexName": {
      "value": "${CHAT_MEMORY_SEARCH_INDEX=chat-memory-v1}"
    },
    "chatMemorySearchLocation": {
      "value": "${CHAT_MEMORY_SEARCH_LOCATION=}"
    },
    "chatHistoryRemoteUrl": {
      "value": "${CHAT_HISTORY_REMOTE_URL=}"
    },
    "agentProjectName": {
      "value": "${AGENT_PROJECT_NAME=planetary-explorer-agents}"
    },
    "deployGpt5": {
      "value": "${DEPLOY_GPT5=false}"
    },
    "deployGpt56": {
      "value": "${DEPLOY_GPT56=false}"
    },
    "deployEmbeddingModel": {
      "value": "${DEPLOY_EMBEDDING_MODEL=true}"
    },
    "deployGeoFm": {
      "value": "${DEPLOY_GEOFM=false}"
    },
    "deployGeoFmServices": {
      "value": "${DEPLOY_GEOFM_SERVICES=true}"
    },
    "geoFmMcpApiKey": {
      "value": "${GEOFM_MCP_API_KEY=}"
    },
    "geoFmOwnerSigningKey": {
      "value": "${GEOFM_OWNER_SIGNING_KEY=}"
    },
    "deployWebSearchMcp": {
      "value": "${DEPLOY_WEB_SEARCH_MCP=false}"
    },
    "webSearchFoundryAccountName": {
      "value": "${WEB_SEARCH_FOUNDRY_ACCOUNT_NAME=}"
    },
    "webSearchFoundryProjectEndpoint": {
      "value": "${WEB_SEARCH_FOUNDRY_PROJECT_ENDPOINT=}"
    },
    "webSearchMcpApiKey": {
      "value": "${WEB_SEARCH_MCP_API_KEY=}"
    },
    "deployBotService": {
      "value": false
    },
    "enableAuthentication": {
      "value": "${ENABLE_AUTHENTICATION=false}"
    },
    "publicDemoMode": {
      "value": "${PUBLIC_DEMO_MODE=false}"
    },
    "microsoftEntraClientId": {
      "value": "${MICROSOFT_ENTRA_CLIENT_ID=}"
    },
    "microsoftEntraTenantId": {
      "value": "${MICROSOFT_ENTRA_TENANT_ID=}"
    },
    "microsoftEntraClientSecret": {
      "value": ""
    },
    "acrAgentPoolName": {
      "value": "buildpool"
    },
    "acrAgentPoolCount": {
      "value": "${ACR_AGENT_POOL_COUNT=0}"
    },
    "enableFabric": {
      "value": "${ENABLE_FABRIC=false}"
    },
    "deployFabricCapacity": {
      "value": "${DEPLOY_FABRIC_CAPACITY=false}"
    },
    "fabricCapacityResourceId": {
      "value": "${FABRIC_CAPACITY_RESOURCE_ID=}"
    },
    "fabricAdministrators": {
      "value": "${FABRIC_ADMINISTRATORS=[]}"
    },
    "fabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID=}"
    },
    "fabricLakehouseId": {
      "value": "${FABRIC_LAKEHOUSE_ID=}"
    },
    "enableMpcPro": {
      "value": "${ENABLE_MPC_PRO=false}"
    },
    "mpcProStacUrl": {
      "value": "${MPC_PRO_STAC_URL=}"
    },
    "mpcProAssetHosts": {
      "value": "${MPC_PRO_ASSET_HOSTS=}"
    },
    "enablePrivateEndpoints": {
      "value": "${ENABLE_PRIVATE_ENDPOINTS=false}"
    },
    "deployWeatherStub": {
      "value": "${DEPLOY_WEATHER_STUB=false}"
    },
    "weatherStubImageName": {
      "value": "${WEATHER_STUB_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}"
    },
    "auroraEndpointUrl": {
      "value": "${AURORA_ENDPOINT_URL=}"
    },
    "earth2FcnEndpointUrl": {
      "value": "${EARTH2_FCN_ENDPOINT_URL=}"
    },
    "maiWeatherEndpointUrl": {
      "value": "${MAI_WEATHER_ENDPOINT_URL=}"
    },
    "maiWeatherScorePath": {
      "value": "${MAI_WEATHER_SCORE_PATH=/mai-weather/score}"
    },
    "forecastAgentEnabled": {
      "value": "${FORECAST_AGENT_ENABLED=true}"
    }
  }
}
